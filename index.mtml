<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Our Love Story</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Prompt', sans-serif;
    }

    body {
      background: linear-gradient(180deg, #120024 0%, #2a0845 100%);
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    .hero-section {
      text-align: center;
      margin-top: 40px;
      margin-bottom: 50px;
    }

    .ring-box {
      width: 120px;
      height: 120px;
      background: #e91e63;
      border: 3px solid #ffd700;
      border-radius: 15px;
      margin: 20px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 50px;
      cursor: pointer;
      box-shadow: 0 0 20px rgba(233, 30, 99, 0.6);
      transition: transform 0.3s ease;
    }

    .ring-box:hover {
      transform: scale(1.05);
    }

    .counter-title {
      font-size: 1.1rem;
      color: #ffb74d;
      margin-bottom: 5px;
    }

    .counter-number {
      font-size: 3rem;
      font-weight: bold;
      color: #fff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

    .timeline {
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      gap: 30px;
      margin-bottom: 50px;
    }

    .photo-card {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      padding: 15px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
      text-align: center;
    }

    .photo-card img {
      width: 100%;
      height: auto;
      max-height: 350px;
      object-fit: cover;
      border-radius: 10px;
      margin-bottom: 10px;
    }

    .photo-card p {
      font-size: 0.95rem;
      color: #f8bbd0;
      line-height: 1.4;
    }

    .message-card {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      border-radius: 15px;
      padding: 20px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      margin-bottom: 40px;
      border: 1px solid rgba(255, 182, 193, 0.3);
    }

    .message-card h2 {
      color: #ff80ab;
      margin-bottom: 10px;
    }

    .message-card p {
      line-height: 1.6;
      font-size: 0.95rem;
      color: #f5f5f5;
    }
  </style>
</head>
<body>

  <div class="hero-section">
    <div class="ring-box" id="openBoxBtn" onclick="playAudio()">💍</div>
    <p style="font-size: 0.8rem; opacity: 0.8;">(แตะที่กล่องเพื่อเปิดเพลง)</p>
    <br>
    <div class="counter-title">เรารักกันมานานแค่ไหนแล้วนะ ♥</div>
    <div class="counter-number" id="daysCounter">0</div>
    <p>วัน</p>
  </div>

  <div class="timeline">
    <div class="photo-card">
      <img src="https://i.ibb.co/xK392p2s/image.jpg" alt="รูปคู่แรก">
      <p>รูปคู่แรกของเราในเดือนพฤศจิกา🩷✨</p>
    </div>

    <div class="photo-card">
      <img src="https://i.ibb.co/tTy35VY4/image.jpg" alt="รักตั้งแต่วันแรก">
      <p>เค้ารักอ้วนตั้งแต่วันแรกที่ได้รักเลยนะ😘💖</p>
    </div>

    <div class="photo-card">
      <img src="https://i.ibb.co/kgVsfnHy/image.jpg" alt="มีความสุข">
      <p>มีอ้วนทุกที่ทุกเวลาเค้ามีความสุขมากๆขอบคุณที่อยู่ข้างๆและรักเค้า🥺💘</p>
    </div>

    <div class="photo-card">
      <img src="https://i.ibb.co/DHwMTXZb/image.jpg" alt="ขอบคุณที่ยังรัก">
      <p>ขอบคุณที่ยังรักเค้าในวันที่เค้าทำตัวไม่ดี🥹 เค้ารักเธอมากนะ</p>
    </div>
  </div>

  <div class="message-card">
    <h2>Dear My Love ❤️</h2>
    <p>
  ขอบคุณที่เข้ามาเป็นเรื่องราวดีๆและเป็นรอยยิ้มในทุกๆวันของเค้านะ 
  ตั้งแต่วันแรกจนถึงวันนี้ไม่เคยมีวันไหนเลยที่ไม่รักอ้วนขอบคุณที่คอยซัพพอร์ตคอยอยู่ข้างๆ<br>
  ไม่ว่าจะเจอเรื่องอะไรก็ตามอยู่สร้างความทรงจำน่ารักๆด้วยกันแบบนี้ไปนานๆนะ
  เค้ารักอ้วนที่สุดในโลกเลย ❤️
    </p>
  </div>

  <!-- เรียกใช้ไฟล์เพลงที่อัปโหลดไว้ -->
  <audio id="bgMusic" loop>
    <source src="song.mp3.mp3" type="audio/mpeg">
  </audio>

  <script>
    // ตั้งค่าวันเริ่มคบเป็นวันที่ 26 ธันวาคม 2025 (ปี 2025, เดือน 11 = ธันวาคม, วันที่ 26)
    const startDate = new Date(2025, 11, 26); 

    function updateCounter() {
      const today = new Date();
      const diffTime = Math.abs(today - startDate);
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
      document.getElementById('daysCounter').innerText = diffDays.toLocaleString();
    }

    function playAudio() {
      const audio = document.getElementById('bgMusic');
      audio.play();
      alert('❤️ ไม่ใช่แค่วันครบรอบเค้าก็รักอ้วนทุกวันนะ! ❤️');
    }

    updateCounter();
  </script>
</body>
</html>
